# 복사해서 .env 로 쓰거나 export 하세요. 실제 키는 절대 커밋하지 않습니다.

# --- LLM (비워두면 오프라인 모드) ---
# 로컬 Ollama 예시
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b
# 유료 API를 쓸 때 1M 토큰당 USD 단가 (비용 지표 계산용)
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# --- 검색 ---
AGENT_EMBEDDER=e5
AGENT_RETRIEVAL=hybrid
AGENT_HYBRID_ALPHA=0.3
AGENT_ABSTAIN=0.78
AGENT_DB=data/agent.db
